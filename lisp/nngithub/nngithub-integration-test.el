;;; nngithub-integration-test.el --- Isolated Gnus smoke test -*- lexical-binding: t; -*-
;; Assisted-By: Codex:gpt-6-astra
;; SPDX-License-Identifier: GPL-3.0-or-later
;; Run in a fresh process; uses temporary Gnus state and makes no API writes:
;; emacs -Q --batch -L lisp/nngithub -l nngithub-integration-test
(require 'nngithub-tests)
(require 'gnus-async)
(require 'gnus-srvr)
(let* ((root (make-temp-file "nngithub-gnus-" t))
       (gnus-home-directory root)
       (gnus-directory (expand-file-name "News/" root))
       (gnus-startup-file (expand-file-name ".newsrc" root))
       (gnus-init-file (expand-file-name "gnus.el" root))
       (gnus-use-dribble-file nil)
       (gnus-save-newsrc-file nil)
       (gnus-select-method '(nnnil ""))
       (gnus-secondary-select-methods nil)
       (gnus-check-new-newsgroups nil)
       (gnus-use-cache nil)
       (gnus-agent nil)
       (gnus-asynchronous nil)
       (gnus-confirm-mail-reply-to-news nil)
       (gnus-inhibit-startup-message t)
       (gnus-interactive-exit nil)
       (user-mail-address "test@example.com")
       (nngithub-directory (expand-file-name "cache/" root)))
  (unwind-protect
      (progn
        (gnus)
        (gnus-group-enter-server-mode)
        (gnus-server-add-server 'nngithub "smoke")
        (cl-letf (((symbol-function 'nngithub--connection)
                   (lambda (&rest _)
                     '(((nameWithOwner . "a/b") (hasIssuesEnabled . t)
                        (hasDiscussionsEnabled . t))))))
          (gnus-server-read-server-in-server-buffer "smoke"))
        (cl-assert (derived-mode-p 'gnus-browse-mode))
        (cl-assert (null (plist-get nngithub--state :groups)))
        (goto-char (point-min))
        (re-search-forward "a/b.issues")
        (beginning-of-line)
        (gnus-browse-toggle-subscription)
        (cl-assert (gnus-get-info "nngithub+smoke:a/b.issues"))
        (gnus-browse-exit)
        (set-buffer gnus-group-buffer)
        (cl-letf (((symbol-function 'nngithub--api)
                   (lambda (&rest _)
                     '((repository . ((id . "REPO") (hasIssuesEnabled . t)
                                      (hasDiscussionsEnabled . t)))))))
          (gnus-group-make-group "a/b.pulls" '(nngithub "smoke"))
          (gnus-group-make-group "a/b.discussions" '(nngithub "smoke")))
        (cl-assert (gnus-get-info "nngithub+smoke:a/b.pulls"))
        (cl-assert (gnus-get-info "nngithub+smoke:a/b.discussions"))
        (nngithub-test--seed "a/b.issues")
        (let ((state (nngithub--group "a/b.issues")))
          (setf (plist-get state :synced) t))
        (cl-letf (((symbol-function 'nngithub--sync) (lambda (&rest _) t)))
          (gnus-group-read-group 20 nil "nngithub+smoke:a/b.issues"))
        (cl-assert (derived-mode-p 'gnus-summary-mode))
        (gnus-summary-first-unread-article)
        (let ((summary (current-buffer)))
          ;; Batch Emacs cannot enable font-lock; Gnus citation mode recurses.
          (cl-letf (((symbol-function 'gnus-message-citation-mode) #'ignore))
            (gnus-summary-reply))
          (cl-assert (derived-mode-p 'message-mode))
          (cl-assert (nngithub--reply-target))
          (cl-assert (equal message-send-method-alist '((nngithub always nngithub--send-reply))))
          (set-buffer summary)
          (cl-letf (((symbol-function 'gnus-message-citation-mode) #'ignore))
            (gnus-summary-followup nil))
          (nngithub--prepare-send)
          (cl-assert (equal message-send-method-alist '((nngithub always nngithub--send-post))))
          (cl-assert (or (message-fetch-field "References") (message-make-references)))
          (message-goto-body)
          (insert "Followup from integration test")
          (let (replied)
            (cl-letf (((symbol-function 'nngithub--reply)
                       (lambda (&rest _) (setq replied t)))
                      ((symbol-function 'nngithub--new)
                       (lambda (&rest _) (error "Followup became a new issue"))))
              (nngithub--send-post))
            (cl-assert replied))
          (set-buffer summary)
          (cl-letf (((symbol-function 'gnus-message-citation-mode) #'ignore))
            (nngithub-compose))
          (cl-assert (equal (message-fetch-field "Newsgroups") "a/b.issues"))
          (nngithub--prepare-send)
          (cl-assert (equal message-send-method-alist '((nngithub always nngithub--send-post)))))
        (princ "Gnus: subscription, reading, reply, followup and new composition passed\n"))
    (dolist (buffer (buffer-list))
      (with-current-buffer buffer
        (when (and buffer-auto-save-file-name
                   (string-prefix-p root buffer-auto-save-file-name))
          (setq buffer-auto-save-file-name nil)
          (set-buffer-modified-p nil))))
    (delete-directory root t)))
